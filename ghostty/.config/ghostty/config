# Ghostty Configuration

theme = Gruvbox Dark

# Font
font-family = "Ubuntu Mono"
# font-family = "Adwaita Mono"
font-size = 13

# Shell
shell-integration = fish

# Auto-attach to (or create) the shared tmux session "main" on every new
# window/tab/split instead of starting a plain shell.
command = tmux new-session -A -s main

# Window
window-decoration = false
window-padding-x = 10
window-padding-y = 10

# Mouse
mouse-scroll-multiplier = 0.5

# Keybindings
keybind = ctrl+shift+n=new_window

keybind = alt+one=unbind
keybind = alt+two=unbind
keybind = alt+three=unbind
keybind = alt+four=unbind
keybind = alt+five=unbind
keybind = alt+six=unbind
keybind = alt+seven=unbind
keybind = alt+eight=unbind
keybind = alt+nine=unbind

